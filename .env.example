APP_NAME=ZATRANO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Drivers: sqlite | mysql | pgsql | mssql | oracle | mongo (install via: go run ./cmd/zatrano db:setup)
DB_CONNECTION=sqlite
# Multi-DB: comma-separated enabled connections (default = DB_CONNECTION only)
# DB_CONNECTIONS=sqlite,mysql,pgsql,mongo
DB_HOST=127.0.0.1
# Per-driver overrides: DB_MYSQL_HOST, DB_PGSQL_PORT, DB_ORACLE_SERVICE, DB_MONGO_URI, …
# DB_PORT=
DB_DATABASE=database/database.sqlite
# DB_USERNAME=
DB_PASSWORD=
# DB_SSLMODE=disable
# DB_SERVICE=FREEPDB1
# DB_MONGO_URI=memory
# DB_MONGO_DATABASE=zatrano

SESSION_DRIVER=file
SESSION_LIFETIME=120
# SESSION_SECURE=true   # force Secure session cookie (also auto when request is HTTPS)

CACHE_STORE=file

QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

SMS_DRIVER=memory
SMS_FROM=ZATRANO
SMS_URL=
SMS_TOKEN=
SMS_METHOD=POST
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFICATION_CHANNELS=database,mail

PUSH_DRIVER=memory
PUSH_URL=
PUSH_TOKEN=

ERROR_WEBHOOK_URL=
REPORT_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SECRET=

CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-Requested-With, X-CSRF-TOKEN, X-Idempotency-Key
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# memory | mongodb://… | mongodb+srv://…
MONGO_URI=memory
STRIPE_SECRET_KEY=
BILLING_DRIVER=memory

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
OAUTH_STORE_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

OCTANE_WORKERS=0
AI_DRIVER=fake
# AI_DRIVER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=30
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=1024

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_SUCCESS_THRESHOLD=2
CIRCUIT_TIMEOUT_SECONDS=30
HASHID_SALT=
HASHID_MIN_LENGTH=8

SHORTURL_PREFIX=/s
SECURITY_CONTACT_EMAIL=
SECURITY_CONTACT_URL=
SECURITY_POLICY_URL=

TRUSTED_PROXIES=
# Production ignores TRUSTED_PROXIES=* unless TRUST_PROXIES_ALLOW_STAR=true (spoof risk).
# TRUST_PROXIES_ALLOW_STAR=true
# MAX_UPLOAD_BYTES=33554432
# COOKIE_SECURE=true

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080
WEBAUTHN_RP_DISPLAY_NAME=ZATRANO
WEBAUTHN_RP_NAME=ZATRANO
