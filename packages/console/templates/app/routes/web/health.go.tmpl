package web

import (
	approutes "__MODULE__/app/routes"

	"github.com/zatrano/framework/packages/http"
	"github.com/zatrano/framework/packages/routing"
)

func init() {
	routing.RegisterWeb(registerHealth)
}

func registerHealth(router *routing.Router) {
	app := approutes.Current()
	if app == nil || router == nil || app.Health() == nil {
		return
	}

	router.Get("/up", func(req *http.Request) *http.Response {
		return http.JSON(map[string]any{"status": "ok"})
	}).As("up")
	if h, ok := app.Health().Handler().(routing.HandlerFunc); ok {
		router.Get("/health", h).As("health")
		router.Get("/api/health", h).As("api.health")
	}
}
