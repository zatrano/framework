.env
# Local Go workspace — use go.mod replace directives, not go.work
go.work
go.work.sum
# Runtime dirs created by tests / local serve (not part of the framework tree)
/storage/
# Track application locale JSON; ignore only local overrides if needed.
# /lang/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
storage/app/uploads/tmp/*
!storage/app/uploads/tmp/.gitkeep
.cursor/
.idea/
.vscode/
*.swp
*.log
*.sqlite
storage/backups/*
!storage/backups/.gitkeep
database/*.sqlite
tests/storage/framework/sessions/*
!tests/storage/framework/sessions/.gitkeep
tests/storage/framework/cache/*
!tests/storage/framework/cache/.gitkeep
tests/storage/framework/views/*
!tests/storage/framework/views/.gitkeep
tests/storage/logs/*
!tests/storage/logs/.gitkeep
tests/database/*.sqlite

storage/framework/schedule/*
!storage/framework/schedule/.gitkeep
# Local Stage A/B/C notes — keep on disk, do not publish
/docs/
