package routes

import (
	"github.com/zatrano/framework/app/http/controllers/web"
	"github.com/zatrano/framework/core"
	"github.com/zatrano/framework/core/auth"
	. "github.com/zatrano/framework/core/routing"
)

// RegisterAuthWeb registers session authentication web routes.
// Wire from Web(): RegisterAuthWeb(app)
func RegisterAuthWeb(app *core.Application) {
	router := app.Router()
	ctrl := &web.AuthController{App: app}

	router.Get("/login", ctrl.LoginForm).As("login")
	router.Post("/login", ctrl.Login).As("login.attempt").Through(app.RateLimiter().Named("login"))
	router.Post("/logout", ctrl.Logout).As("logout")

	social := &web.SocialAuthController{App: app}
	router.Get("/login/google", social.GoogleRedirect).As("login.google")
	router.Get("/auth/google/callback", social.GoogleCallback).As("login.google.callback")
	router.Get("/login/github", social.GitHubRedirect).As("login.github")
	router.Get("/auth/github/callback", social.GitHubCallback).As("login.github.callback")

	router.Group("", func(r *Router) {
		r.Get("/register", ctrl.RegisterForm).As("register")
		r.Post("/register", ctrl.Register).As("register.store").Through(app.RateLimiter().Named("login"))
	}, auth.RedirectIfAuthenticated(app.Auth(), "/"))

	router.Group("", func(r *Router) {
		r.Get("/profile", ctrl.ProfileForm).As("profile")
		r.Post("/profile", ctrl.UpdateProfile).As("profile.update")
		r.Get("/password/change", ctrl.ChangePasswordForm).As("password.change")
		r.Post("/password/change", ctrl.ChangePassword).As("password.change.store")
		r.Get("/user/two-factor", ctrl.TwoFactorForm).As("two-factor.index")
		r.Post("/user/two-factor/enable", ctrl.EnableTwoFactor).As("two-factor.enable")
		r.Post("/user/two-factor/confirm", ctrl.ConfirmTwoFactor).As("two-factor.confirm")
		r.Post("/user/two-factor/disable", ctrl.DisableTwoFactor).As("two-factor.disable")
		r.Post("/user/two-factor/recovery-codes", ctrl.RegenerateRecoveryCodes).As("two-factor.recovery-codes")
		r.Get("/user/logout-other-devices", ctrl.LogoutOtherDevicesForm).As("logout-other-devices")
		r.Post("/user/logout-other-devices", ctrl.LogoutOtherDevices).As("logout-other-devices.store")
		r.Get("/confirm-password", ctrl.ConfirmPasswordForm).As("password.confirm")
		r.Post("/confirm-password", ctrl.ConfirmPassword).As("password.confirm.store")
		r.Get("/email/verify", ctrl.Notice).As("verification.notice")
		r.Post("/email/verification-notification", ctrl.Send).As("verification.send")
	}, auth.Middleware(app.Auth()))

	router.Get("/two-factor-challenge", ctrl.TwoFactorChallengeForm).As("two-factor.challenge")
	router.Post("/two-factor-challenge", ctrl.TwoFactorChallenge).As("two-factor.challenge.store")

	router.Get("/forgot-password", ctrl.ForgotForm).As("password.request")
	router.Post("/forgot-password", ctrl.Forgot).As("password.email").Through(app.RateLimiter().Named("login"))
	router.Get("/reset-password", ctrl.ResetForm).As("password.reset")
	router.Post("/reset-password", ctrl.Reset).As("password.update")
	router.Get("/email/verify/{id}", ctrl.Verify).As("verification.verify")
}

// RegisterAuthAPI registers JSON authentication API routes under /api.
// Wire from API(): RegisterAuthAPI(app)
func RegisterAuthAPI(app *core.Application) {
	ctrl := &web.AuthController{App: app}

	app.Router().Group("/api", func(api *Router) {
		api.Post("/login", ctrl.Login).As("api.login").Through(app.RateLimiter().Named("login"))
		api.Post("/register", ctrl.Register).As("api.register").Through(app.RateLimiter().Named("login"))
		api.Post("/password/forgot", ctrl.Forgot).As("api.password.forgot").Through(app.RateLimiter().Named("login"))
		api.Post("/password/reset", ctrl.Reset).As("api.password.reset")
		api.Post("/auth/two-factor/challenge", ctrl.TwoFactorChallenge).As("api.auth.two-factor.challenge")
		api.Group("", func(r *Router) {
			r.Post("/logout", ctrl.Logout).As("api.logout")
			r.Post("/profile", ctrl.UpdateProfile).As("api.profile.update")
			r.Post("/password/change", ctrl.ChangePassword).As("api.password.change")
			r.Post("/auth/logout-other-devices", ctrl.LogoutOtherDevices).As("api.auth.logout-other-devices")
			r.Post("/auth/two-factor/enable", ctrl.EnableTwoFactor).As("api.auth.two-factor.enable")
			r.Post("/auth/two-factor/confirm", ctrl.ConfirmTwoFactor).As("api.auth.two-factor.confirm")
			r.Post("/auth/two-factor/disable", ctrl.DisableTwoFactor).As("api.auth.two-factor.disable")
			r.Post("/auth/two-factor/recovery-codes", ctrl.RegenerateRecoveryCodes).As("api.auth.two-factor.recovery-codes")
		}, auth.Middleware(app.Auth()))
	})
}
