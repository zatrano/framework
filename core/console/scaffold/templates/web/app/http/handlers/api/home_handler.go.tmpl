package api

import "github.com/zatrano/framework/v3/core/kernel/http"

// HomeHandler serves API root information.
type HomeHandler struct{}

// Index returns application name and scaffold framework pin.
func (c *HomeHandler) Index(req *http.Request) *http.Response {
	return http.JSON(map[string]any{
		"name":    "__APP_NAME__",
		"version": "__FRAMEWORK_VERSION__",
	})
}
