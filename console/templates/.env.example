APP_NAME=__APP_NAME__
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database is optional. Link a driver with:
#   go run ./cmd/app db:setup --drivers=sqlite
#   go run ./cmd/app db:setup --drivers=mysql --default=mysql
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525

CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-Requested-With, X-CSRF-TOKEN, X-Idempotency-Key
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600
