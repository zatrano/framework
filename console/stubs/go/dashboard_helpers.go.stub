package web

import (
	"github.com/zatrano/framework/v2/contracts"
	"fmt"
	"strconv"

	"__MODULE__/app/models"
	"github.com/zatrano/packages/auth"
	"github.com/zatrano/framework/v2/kernel/http"
	"github.com/zatrano/packages/localization"
)

func dashboardLang(app contracts.App, key string, replace ...map[string]string) string {
	if tr := localization.From(app); tr != nil {
		return tr.Get(key, replace...)
	}
	return key
}

func dashboardCurrentUser(req *http.Request, app contracts.App) *models.User {
	raw := auth.From(app).User(req)
	if raw == nil {
		return nil
	}
	if u, ok := raw.(*models.User); ok {
		return u
	}
	return nil
}

func dashboardUserIDString(u *models.User) string {
	if u == nil {
		return ""
	}
	return fmt.Sprintf("%d", u.ID)
}

func dashboardParseID(req *http.Request, key string) (int64, error) {
	raw := req.Route(key)
	if raw == "" {
		raw = req.Input(key)
	}
	return strconv.ParseInt(raw, 10, 64)
}
