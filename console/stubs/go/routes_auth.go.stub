package routes

import (
	"github.com/zatrano/framework/v2/contracts"
	"__MODULE__/app/http/controllers/web"
	apipkg "github.com/zatrano/framework/v2/api"
	"github.com/zatrano/packages/auth"
	"github.com/zatrano/packages/ratelimit"
	"github.com/zatrano/framework/v2/kernel/routing"
)

// RegisterAuthWeb registers session authentication web routes under /auth.
// Wire from Web(): RegisterAuthWeb(app)
func RegisterAuthWeb(app contracts.App) {
	router := routing.From(app)
	ctrl := &web.AuthController{App: app}
	social := &web.SocialAuthController{App: app}

	router.Group("/auth", func(r *routing.Router) {
		r.Get("/login", ctrl.LoginForm).As("login")
		r.Post("/login", ctrl.Login).As("login.attempt").Through(ratelimit.From(app).Named("login"))
		r.Post("/logout", ctrl.Logout).As("logout")

		r.Get("/google/login", social.GoogleRedirect).As("login.google")
		r.Get("/google/callback", social.GoogleCallback).As("login.google.callback")
		r.Get("/github/login", social.GitHubRedirect).As("login.github")
		r.Get("/github/callback", social.GitHubCallback).As("login.github.callback")

		r.Group("", func(g *routing.Router) {
			g.Get("/register", ctrl.RegisterForm).As("register")
			g.Post("/register", ctrl.Register).As("register.store").Through(ratelimit.From(app).Named("login"))
		}, auth.RedirectIfAuthenticated(auth.From(app), "/"))

		r.Get("/two-factor-challenge", ctrl.TwoFactorChallengeForm).As("two-factor.challenge")
		r.Post("/two-factor-challenge", ctrl.TwoFactorChallenge).As("two-factor.challenge.store")

		r.Get("/forgot-password", ctrl.ForgotForm).As("password.request")
		r.Post("/forgot-password", ctrl.Forgot).As("password.email").Through(ratelimit.From(app).Named("login"))
		r.Get("/reset-password", ctrl.ResetForm).As("password.reset")
		r.Post("/reset-password", ctrl.Reset).As("password.update")
		r.Get("/email/verify/{id}", ctrl.Verify).As("verification.verify")

		r.Group("", func(g *routing.Router) {
			g.Get("/confirm-password", ctrl.ConfirmPasswordForm).As("password.confirm")
			g.Post("/confirm-password", ctrl.ConfirmPassword).As("password.confirm.store")
			g.Get("/email/verify", ctrl.Notice).As("verification.notice")
			g.Post("/email/verification-notification", ctrl.Send).As("verification.send")

			g.Get("/profile", ctrl.ProfileForm).As("profile")
			g.Post("/profile", ctrl.UpdateProfile).As("profile.update")
			g.Get("/password/change", ctrl.ChangePasswordForm).As("password.change")
			g.Post("/password/change", ctrl.ChangePassword).As("password.change.store")
			g.Get("/user/two-factor", ctrl.TwoFactorForm).As("two-factor.index")
			g.Post("/user/two-factor/enable", ctrl.EnableTwoFactor).As("two-factor.enable")
			g.Post("/user/two-factor/confirm", ctrl.ConfirmTwoFactor).As("two-factor.confirm")
			g.Post("/user/two-factor/disable", ctrl.DisableTwoFactor).As("two-factor.disable")
			g.Post("/user/two-factor/recovery-codes", ctrl.RegenerateRecoveryCodes).As("two-factor.recovery-codes")
			g.Get("/user/logout-other-devices", ctrl.LogoutOtherDevicesForm).As("logout-other-devices")
			g.Post("/user/logout-other-devices", ctrl.LogoutOtherDevices).As("logout-other-devices.store")
		}, auth.Middleware(auth.From(app)))
	})

	// Example verified-only group â€” wrap routes that require a verified email:
	// auth.Middleware(auth.From(app)), auth.VerifyEmailMiddleware(auth.From(app))
}

// RegisterAuthAPI registers JSON authentication API routes under /api/v1/auth.
// Wire from API(): RegisterAuthAPI(app)
func RegisterAuthAPI(app contracts.App) {
	ctrl := &web.AuthController{App: app}

	apipkg.Version(routing.From(app), "v1", func(api *routing.Router) {
		api.Group("/auth", func(r *routing.Router) {
			r.Post("/login", ctrl.Login).As("api.v1.login").Through(ratelimit.From(app).Named("login"))
			r.Post("/register", ctrl.Register).As("api.v1.register").Through(ratelimit.From(app).Named("login"))
			r.Post("/password/forgot", ctrl.Forgot).As("api.v1.password.forgot").Through(ratelimit.From(app).Named("login"))
			r.Post("/password/reset", ctrl.Reset).As("api.v1.password.reset")
			r.Post("/two-factor/challenge", ctrl.TwoFactorChallenge).As("api.v1.auth.two-factor.challenge")
			r.Group("", func(g *routing.Router) {
				g.Post("/logout", ctrl.Logout).As("api.v1.logout")
				g.Post("/profile", ctrl.UpdateProfile).As("api.v1.profile.update")
				g.Post("/password/change", ctrl.ChangePassword).As("api.v1.password.change")
				g.Post("/logout-other-devices", ctrl.LogoutOtherDevices).As("api.v1.auth.logout-other-devices")
				g.Post("/two-factor/enable", ctrl.EnableTwoFactor).As("api.v1.auth.two-factor.enable")
				g.Post("/two-factor/confirm", ctrl.ConfirmTwoFactor).As("api.v1.auth.two-factor.confirm")
				g.Post("/two-factor/disable", ctrl.DisableTwoFactor).As("api.v1.auth.two-factor.disable")
				g.Post("/two-factor/recovery-codes", ctrl.RegenerateRecoveryCodes).As("api.v1.auth.two-factor.recovery-codes")
				g.Post("/confirm-password", ctrl.ConfirmPassword).As("api.v1.auth.confirm-password")
			}, auth.Middleware(auth.From(app)))
		})
	})
}
